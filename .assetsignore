# Files Wrangler must NOT upload as servable static assets when deploying the
# prepfusion-landing-site Worker (wrangler.toml at the repo root, whose
# [assets] directory is the repo root itself). Everything else in the repo is
# the website. GitHub Pages ignores this file.

# Version control and local state
.git
.gitignore
.wrangler
node_modules

# GitHub Pages-only files
.nojekyll
CNAME

# Worker sources and config (the apex redirect Worker and this one)
cloudflare
hosting
wrangler.toml
.assetsignore

# Tooling, docs and design skills: not part of the site
tools
docs
.claude
.github
